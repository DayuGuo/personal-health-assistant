# Prefer pnpm run setup to generate this file and render site assets.
name = "your-health-bridge"
main = "src/index.ts"
compatibility_date = "2026-04-28"
compatibility_flags = ["nodejs_compat", "global_fetch_strictly_public"]
workers_dev = true
[vars]
PUBLIC_ORIGIN = "https://health.example.com"
OWNER_EMAIL = "owner@example.com"
# Extra agents are disabled by default. Use pnpm run setup:agents after deployment.
# The optional MCP_CLIENT_POLICY secret contains exact CIMD/callback or DCR rules.
[assets]
directory = ".setup/site"
binding = "ASSETS"
run_worker_first = true
[[kv_namespaces]]
binding = "OAUTH_KV"
id = "REPLACE_AUTH_NAMESPACE"
[[kv_namespaces]]
binding = "TOKENS"
id = "REPLACE_AUTH_NAMESPACE"
[[kv_namespaces]]
binding = "CACHE"
id = "REPLACE_CACHE_NAMESPACE"
# OAUTH_KV and TOKENS share one namespace; application keys start health:.
# Secrets: LOGIN_CLIENT_ID, LOGIN_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
# Never configure a shared secret in a URL or expose a public health API.
